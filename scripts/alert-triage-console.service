[Unit]
Description=Alert triage read-only local console
After=alert-triage-mock.service
Requires=alert-triage-mock.service

[Service]
User=ecs-user
WorkingDirectory=/home/ecs-user/alert-triage-demo
Environment=CONSOLE_UPSTREAM_URL=http://172.17.0.1:8081
Environment=CONSOLE_HOST=127.0.0.1
Environment=CONSOLE_PORT=8080
ExecStart=/usr/bin/node scripts/serve-console.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
