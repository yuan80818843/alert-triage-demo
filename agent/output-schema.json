{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "alert_id", "classification", "confidence", "evidence_chain", "missing_evidence", "next_actions", "rule_hits", "human_review_required", "proposed_disposition"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "classification": {"enum": ["REAL_ATTACK", "SUSPECTED_FALSE_POSITIVE", "INSUFFICIENT_EVIDENCE"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_chain": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "source", "method", "observed_at", "fact"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "fact": {"type": "string", "minLength": 1}
        }
      }
    },
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rule_hits": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean"},
    "proposed_disposition": {"enum": ["ESCALATE", "ESCALATE_FOR_HUMAN_REVIEW", "HOLD_FOR_REVIEW", "REQUEST_MORE_EVIDENCE"]},
    "similar_case_ids": {"type": "array", "items": {"type": "string"}},
    "explanation": {"type": "string"}
  }
}

