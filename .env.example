# Pin real releases or digests before cloud deployment.
# Official commit snapshot (not a stable release): network policy requires it.
AGENT_COMPOSE_IMAGE=chaitin/agent-compose:sha-70bfd0b
AGENT_COMPOSE_GUEST_IMAGE=chaitin/agent-compose-guest:sha-70bfd0b
AGENT_COMPOSE_AUTH_TOKEN=replace-with-a-separate-random-daemon-token
OCTOBUS_IMAGE=ghcr.io/chaitin/octobus@sha256:377409360a3d54f8e058340a7fb4874a994f18d11d35ba8f7cae0bec23a724a6
OCTOBUS_ADMIN_TOKEN=replace-with-local-demo-token
# Create this through the OctoBus capset CLI; never invent or commit its value.
OCTOBUS_TRIAGE_READ_TOKEN=replace-with-octobus-scoped-triage-read-token
OCTOBUS_URL=http://octobus:9000
OCTOBUS_UPSTREAM_URL=http://mock-upstream:8080
# Public synthetic capsets are confined to Docker networks in this demo.
# Production must provision a scoped OctoBus capset token separately.
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=8080
MOCK_UPSTREAM_PORT=8081
AGENT_COMPOSE_PORT=7410
SCHEDULER_RUN_TIMEOUT=10m
AGENT_MAX_CONCURRENCY=1
# On upgrades, preserve the old daemon data directory and use a fresh one for
# this synthetic demo, or follow the upstream V2 migration guide.
AGENT_COMPOSE_DATA_DIR=./agent-compose-data

